        "\n",
        "# Assignment 1: Calculate Undiscounted and Discounted Returns\n",
        "\n",
        "n = int(input(\"Enter the number of time steps: \"))\n",
        "\n",
        "rewards = []\n",
        "for i in range(n):\n",
        "    reward = float(input(f\"Enter reward for time step {i + 1}: \"))\n",
        "    rewards.append(reward)\n",
        "\n",
        "gamma = float(input(\"Enter the discount factor (gamma): \"))\n",
        "\n",
        "# Calculate undiscounted return\n",
        "undiscounted_return = sum(rewards)\n",
        "\n",
        "# Calculate discounted return\n",
        "discounted_return = 0.0\n",
        "for t in range(n):\n",
        "    discounted_return += (gamma ** t) * rewards[t]\n",
        "\n",
        "print(\"\\nEntered reward values:\", rewards)\n",
        "print(\"Undiscounted Return:\", undiscounted_return)\n",
        "print(\"Discounted Return:\", round(discounted_return, 4))"
