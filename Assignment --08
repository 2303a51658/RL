      "source": [
        "\n",
        "\n",
        "# Assignment 8: State Value and Action Value Functions\n",
        "# 2 x 3 Grid World using Trajectory Method\n",
        "# Without using the Bellman Equation\n",
        "\n",
        "# State space\n",
        "STATE_SPACE = [\"S0\", \"S1\", \"G\", \"S3\", \"S4\"]\n",
        "\n",
        "# Action space\n",
        "ACTION_SPACE = [\"Up\", \"Down\", \"Left\", \"Right\"]\n",
        "\n",
        "# Grid positions\n",
        "STATE_POSITIONS = {\n",
        "    \"S0\": (0, 0),\n",
        "    \"S1\": (0, 1),\n",
        "    \"G\":  (0, 2),\n",
        "    \"S3\": (1, 1),\n",
        "    \"S4\": (1, 2)\n",
        "}\n",
        "\n",
        "OBSTACLE = (1, 0)\n",
        "\n",
        "# Environment parameters\n",
        "GAMMA = 0.9\n",
        "NORMAL_REWARD = -1\n",
        "GOAL_REWARD = 10\n",
        "OBSTACLE_REWARD = -5\n",
        "\n",
        "# Given policy\n",
        "POLICY = {\n",
        "    \"S0\": \"Right\",\n",
        "    \"S1\": \"Down\",\n",
        "    \"S3\": \"Right\",\n",
        "    \"S4\": \"Up\"\n",
        "}\n",
        "\n",
        "\n",
        "# Transition function\n",
        "def get_next_state(state, action):\n",
        "    if state == \"G\":\n",
        "        return \"G\"\n",
        "\n",
        "    row, col = STATE_POSITIONS[state]\n",
        "\n",
        "    moves = {\n",
        "        \"Up\": (-1, 0),\n",
        "        \"Down\": (1, 0),\n",
        "        \"Left\": (0, -1),\n",
        "        \"Right\": (0, 1)\n",
        "    }\n",
        "\n",
        "    dr, dc = moves[action]\n",
        "    new_position = (row + dr, col + dc)\n",
        "\n",
        "    # Stay in the same state at grid boundaries\n",
        "    if not (0 <= new_position[0] < 2 and\n",
        "            0 <= new_position[1] < 3):\n",
        "        return state\n",
        "\n",
        "    # Do not enter the obstacle\n",
        "    if new_position == OBSTACLE:\n",
        "        return state\n",
        "\n",
        "    for next_state, position in STATE_POSITIONS.items():\n",
        "        if position == new_position:\n",
        "            return next_state\n",
        "\n",
        "    return state\n",
        "\n",
        "\n",
        "# Reward function\n",
        "def get_reward(state, action, next_state):\n",
        "    if state == \"G\":\n",
        "        return 0\n",
        "\n",
        "    row, col = STATE_POSITIONS[state]\n",
        "\n",
        "    moves = {\n",
        "        \"Up\": (-1, 0),\n",
        "        \"Down\": (1, 0),\n",
        "        \"Left\": (0, -1),\n",
        "        \"Right\": (0, 1)\n",
        "    }\n",
        "\n",
        "    dr, dc = moves[action]\n",
        "    attempted_position = (row + dr, col + dc)\n",
        "\n",
        "    if attempted_position == OBSTACLE:\n",
        "        return OBSTACLE_REWARD\n",
        "\n",
        "    if next_state == \"G\":\n",
        "        return GOAL_REWARD\n",
        "\n",
        "    return NORMAL_REWARD\n",
        "\n",
        "\n",
        "# State value function using trajectory method\n",
        "def state_value_function(start_state):\n",
        "    state = start_state\n",
        "    total_return = 0.0\n",
        "    discount = 1.0\n",
        "    trajectory = []\n",
        "    max_steps = 100\n",
        "\n",
        "    for step in range(max_steps):\n",
        "        if state == \"G\":\n",
        "            break\n",
        "\n",
        "        action = POLICY[state]\n",
        "        next_state = get_next_state(state, action)\n",
        "        reward = get_reward(state, action, next_state)\n",
        "\n",
        "        trajectory.append((state, action, next_state, reward))\n",
        "        total_return += discount * reward\n",
        "        discount *= GAMMA\n",
        "        state = next_state\n",
        "\n",
        "    if state != \"G\":\n",
        "        raise RuntimeError(\"Policy did not reach the goal.\")\n",
        "\n",
        "    return total_return, trajectory\n",
        "\n",
        "\n",
        "# Action value function using trajectory method\n",
        "def action_value_function(start_state, first_action):\n",
        "    state = start_state\n",
        "    action = first_action\n",
        "    total_return = 0.0\n",
        "    discount = 1.0\n",
        "    trajectory = []\n",
        "    max_steps = 100\n",
        "\n",
        "    for step in range(max_steps):\n",
        "        if state == \"G\":\n",
        "            break\n",
        "\n",
        "        next_state = get_next_state(state, action)\n",
        "        reward = get_reward(state, action, next_state)\n",
        "\n",
        "        trajectory.append((state, action, next_state, reward))\n",
        "        total_return += discount * reward\n",
        "        discount *= GAMMA\n",
        "\n",
        "        state = next_state\n",
        "\n",
        "        if state != \"G\":\n",
        "            action = POLICY[state]\n",
        "\n",
        "    if state != \"G\":\n",
        "        raise RuntimeError(\"Policy did not reach the goal.\")\n",
        "\n",
        "    return total_return, trajectory\n",
        "\n",
        "\n",
        "# Main program\n",
        "def main():\n",
        "    print(\"===== GRID WORLD: VALUE FUNCTIONS =====\")\n",
        "    print(\"State Space:\", STATE_SPACE)\n",
        "    print(\"Action Space:\", ACTION_SPACE)\n",
        "    print(\"Discount Factor:\", GAMMA)\n",
        "    print(\"Policy:\", POLICY)\n",
        "\n",
        "    # State value for S0\n",
        "    v_s0, state_trajectory = state_value_function(\"S0\")\n",
        "\n",
        "    print(\"\\nState Value Function\")\n",
        "    print(\"State: S0\")\n",
        "    for s, a, ns, r in state_trajectory:\n",
        "        print(f\"{s} --{a}--> {ns}, Reward = {r}\")\n",
        "\n",
        "    print(\"V(S0) =\", round(v_s0, 4))\n",
        "\n",
        "    # Action value for S0 and action Up\n",
        "    q_s0_up, action_trajectory = action_value_function(\n",
        "        \"S0\", \"Up\"\n",
        "    )\n",
        "\n",
        "    print(\"\\nAction Value Function\")\n",
        "    print(\"State: S0, First Action: Up\")\n",
        "    for s, a, ns, r in action_trajectory:\n",
        "        print(f\"{s} --{a}--> {ns}, Reward = {r}\")\n",
        "\n",
        "    print(\"Q(S0, Up) =\", round(q_s0_up, 4))\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
