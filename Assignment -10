    {
      "cell_type": "code",
      "source": [
        "\n",
        "# PRACTICAL - 10\n",
        "# VALUE ITERATION IN A DETERMINISTIC GRID WORLD\n",
        "\n",
        "# 1. Define the MDP\n",
        "states = [\"S0\", \"S1\"]\n",
        "actions = [\"Up\", \"Down\", \"Left\", \"Right\"]\n",
        "\n",
        "gamma = 0.9\n",
        "theta = 1e-6\n",
        "\n",
        "goal_state = \"G\"\n",
        "\n",
        "# Transition mapping: next state and immediate reward\n",
        "transitions = {\n",
        "    \"S0\": {\n",
        "        \"Up\": (\"S0\", -1),\n",
        "        \"Down\": (\"S1\", -1),\n",
        "        \"Left\": (\"S0\", -1),\n",
        "        \"Right\": (\"S0\", -1)\n",
        "    },\n",
        "    \"S1\": {\n",
        "        \"Up\": (\"S0\", -1),\n",
        "        \"Down\": (\"S1\", -1),\n",
        "        \"Left\": (\"S1\", -1),\n",
        "        \"Right\": (\"G\", 100)\n",
        "    }\n",
        "}\n",
        "\n",
        "# 2. Display MDP information\n",
        "print(\"===== PRACTICAL 10: VALUE ITERATION =====\")\n",
        "\n",
        "print(\"\\nStates:\", states + [goal_state])\n",
        "print(\"Actions:\", actions)\n",
        "print(\"Discount factor:\", gamma)\n",
        "print(\"Normal movement reward: -1\")\n",
        "print(\"Wall reward: -1\")\n",
        "print(\"Goal reward: +100\")\n",
        "print(\"Environment: Deterministic\")\n",
        "print(\"Terminal state value V(G): 0\")\n",
        "\n",
        "print(\"\\n===== TRANSITION INFORMATION =====\")\n",
        "\n",
        "for state in states:\n",
        "    for action in actions:\n",
        "        next_state, reward = transitions[state][action]\n",
        "        print(\n",
        "            \"State:\", state,\n",
        "            \"| Action:\", action,\n",
        "            \"| Next State:\", next_state,\n",
        "            \"| Reward:\", reward\n",
        "        )\n",
        "\n",
        "# 3. Initialize state values\n",
        "V = {\n",
        "    \"S0\": 0.0,\n",
        "    \"S1\": 0.0,\n",
        "    \"G\": 0.0\n",
        "}\n",
        "\n",
        "print(\"\\n===== INITIAL STATE VALUES =====\")\n",
        "print(\"S0 =\", V[\"S0\"])\n",
        "print(\"S1 =\", V[\"S1\"])\n",
        "print(\"G  =\", V[\"G\"])\n",
        "\n",
        "# 4. Perform Value Iteration\n",
        "iteration = 0\n",
        "\n",
        "print(\"\\n===== VALUE ITERATION PROCESS =====\")\n",
        "print(\"Iteration | V(S0) | V(S1) | Delta\")\n",
        "\n",
        "while True:\n",
        "    iteration += 1\n",
        "    new_V = V.copy()\n",
        "\n",
        "    # Synchronous update: use only previous iteration values\n",
        "    for state in states:\n",
        "        action_values = []\n",
        "\n",
        "        for action in actions:\n",
        "            next_state, reward = transitions[state][action]\n",
        "\n",
        "            q_value = reward + gamma * V[next_state]\n",
        "            action_values.append(q_value)\n",
        "\n",
        "        new_V[state] = max(action_values)\n",
        "\n",
        "    # Calculate maximum change\n",
        "    delta = max(\n",
        "        abs(new_V[state] - V[state])\n",
        "        for state in states\n",
        "    )\n",
        "\n",
        "    V = new_V\n",
        "\n",
        "    print(\n",
        "        iteration, \"|\",\n",
        "        round(V[\"S0\"], 6), \"|\",\n",
        "        round(V[\"S1\"], 6), \"|\",\n",
        "        round(delta, 6)\n",
        "    )\n",
        "\n",
        "    # Stop when convergence is reached\n",
        "    if delta < theta:\n",
        "        break\n",
        "\n",
        "# 5. Calculate action values after convergence\n",
        "Q = {}\n",
        "\n",
        "for state in states:\n",
        "    Q[state] = {}\n",
        "\n",
        "    for action in actions:\n",
        "        next_state, reward = transitions[state][action]\n",
        "\n",
        "        Q[state][action] = (\n",
        "            reward + gamma * V[next_state]\n",
        "        )\n",
        "\n",
        "# 6. Extract the optimal policy\n",
        "optimal_policy = {}\n",
        "\n",
        "for state in states:\n",
        "    best_value = max(Q[state].values())\n",
        "\n",
        "    optimal_policy[state] = [\n",
        "        action\n",
        "        for action in actions\n",
        "        if abs(Q[state][action] - best_value) < 1e-9\n",
        "    ]\n",
        "\n",
        "# 7. Display final state values\n",
        "print(\"\\n===== FINAL OPTIMAL STATE VALUES =====\")\n",
        "\n",
        "for state in states + [goal_state]:\n",
        "    print(\"V(\" + state + \") =\", round(V[state], 6))\n",
        "\n",
        "# 8. Display action-value table\n",
        "print(\"\\n===== ACTION VALUE TABLE Q(s, a) =====\")\n",
        "\n",
        "for state in states:\n",
        "    print(\"\\nState:\", state)\n",
        "\n",
        "    for action in actions:\n",
        "        print(\n",
        "            action, \"=\", round(Q[state][action], 6)\n",
        "        )\n",
        "\n",
        "# 9. Display optimal policy\n",
        "print(\"\\n===== OPTIMAL POLICY =====\")\n",
        "\n",
        "for state in states:\n",
        "    print(\n",
        "        state, \"->\",\n",
        "        \" / \".join(optimal_policy[state])\n",
        "    )\n",
        "\n",
        "# 10. Verify Bellman Optimality\n",
        "print(\"\\n===== BELLMAN OPTIMALITY VERIFICATION =====\")\n",
        "\n",
        "for state in states:\n",
        "    maximum_q = max(Q[state].values())\n",
        "\n",
        "    print(\n",
        "        \"V(\" + state + \") =\",\n",
        "        round(V[state], 6),\n",
        "        \"| max Q(\" + state + \", a) =\",\n",
        "        round(maximum_q, 6),\n",
        "        \"| Verified:\",\n",
        "        abs(V[state] - maximum_q) < 1e-6\n",
        "    )\n",
        "\n",
        "print(\"\\nValue Iteration completed successfully.\")"
      ],
