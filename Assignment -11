    {
      "cell_type": "code",
      "source": [
        "\n",
        "# PRACTICAL - 11\n",
        "# POLICY ITERATION IN A DETERMINISTIC GRID WORLD\n",
        "\n",
        "# 1. Define the MDP\n",
        "states = [\"S0\", \"S1\"]\n",
        "actions = [\"Up\", \"Down\", \"Left\", \"Right\"]\n",
        "\n",
        "gamma = 0.9\n",
        "theta = 1e-8\n",
        "\n",
        "goal_state = \"G\"\n",
        "\n",
        "# Transition mapping: next state and immediate reward\n",
        "transitions = {\n",
        "    \"S0\": {\n",
        "        \"Up\": (\"S0\", -1),\n",
        "        \"Down\": (\"S1\", -1),\n",
        "        \"Left\": (\"S0\", -1),\n",
        "        \"Right\": (\"S0\", -1)\n",
        "    },\n",
        "    \"S1\": {\n",
        "        \"Up\": (\"S0\", -1),\n",
        "        \"Down\": (\"S1\", -1),\n",
        "        \"Left\": (\"S1\", -1),\n",
        "        \"Right\": (\"G\", 100)\n",
        "    }\n",
        "}\n",
        "\n",
        "# 2. Display MDP information\n",
        "print(\"===== PRACTICAL 11: POLICY ITERATION =====\")\n",
        "\n",
        "print(\"\\nStates:\", states + [goal_state])\n",
        "print(\"Actions:\", actions)\n",
        "print(\"Discount factor:\", gamma)\n",
        "print(\"Normal movement reward: -1\")\n",
        "print(\"Wall reward: -1\")\n",
        "print(\"Goal reward: +100\")\n",
        "print(\"Environment: Deterministic\")\n",
        "print(\"Terminal state value V(G): 0\")\n",
        "\n",
        "print(\"\\n===== TRANSITION INFORMATION =====\")\n",
        "\n",
        "for state in states:\n",
        "    for action in actions:\n",
        "        next_state, reward = transitions[state][action]\n",
        "\n",
        "        print(\n",
        "            \"State:\", state,\n",
        "            \"| Action:\", action,\n",
        "            \"| Next State:\", next_state,\n",
        "            \"| Reward:\", reward\n",
        "        )\n",
        "\n",
        "# 3. Initialize the policy as specified in the assignment\n",
        "policy = {\n",
        "    \"S0\": \"Up\",\n",
        "    \"S1\": \"Up\"\n",
        "}\n",
        "\n",
        "# Initialize state values\n",
        "V = {\n",
        "    \"S0\": 0.0,\n",
        "    \"S1\": 0.0,\n",
        "    \"G\": 0.0\n",
        "}\n",
        "\n",
        "print(\"\\n===== INITIAL POLICY =====\")\n",
        "\n",
        "for state in states:\n",
        "    print(state, \"->\", policy[state])\n",
        "\n",
        "print(\"\\nInitial state values:\", V)\n",
        "\n",
        "# 4. Policy Iteration\n",
        "policy_iteration = 0\n",
        "\n",
        "while True:\n",
        "    policy_iteration += 1\n",
        "\n",
        "    print(\n",
        "        \"\\n===== POLICY ITERATION\",\n",
        "        policy_iteration,\n",
        "        \"=====\"\n",
        "    )\n",
        "\n",
        "    # STEP 1: POLICY EVALUATION\n",
        "    # Evaluate the current policy until convergence\n",
        "    evaluation_iterations = 0\n",
        "\n",
        "    while True:\n",
        "        delta = 0.0\n",
        "\n",
        "        for state in states:\n",
        "            action = policy[state]\n",
        "\n",
        "            next_state, reward = transitions[state][action]\n",
        "\n",
        "            old_value = V[state]\n",
        "\n",
        "            new_value = reward + gamma * V[next_state]\n",
        "\n",
        "            V[state] = new_value\n",
        "\n",
        "            delta = max(\n",
        "                delta,\n",
        "                abs(new_value - old_value)\n",
        "            )\n",
        "\n",
        "        evaluation_iterations += 1\n",
        "\n",
        "        if delta < theta:\n",
        "            break\n",
        "\n",
        "    print(\"\\nPolicy Evaluation:\")\n",
        "    print(\"Evaluation iterations:\", evaluation_iterations)\n",
        "\n",
        "    for state in states + [goal_state]:\n",
        "        print(\n",
        "            \"V(\" + state + \") =\",\n",
        "            round(V[state], 6)\n",
        "        )\n",
        "\n",
        "    # STEP 2: CALCULATE ACTION VALUES\n",
        "    Q = {}\n",
        "\n",
        "    for state in states:\n",
        "        Q[state] = {}\n",
        "\n",
        "        for action in actions:\n",
        "            next_state, reward = transitions[state][action]\n",
        "\n",
        "            Q[state][action] = (\n",
        "                reward + gamma * V[next_state]\n",
        "            )\n",
        "\n",
        "    print(\"\\nAction Values:\")\n",
        "\n",
        "    for state in states:\n",
        "        print(\"\\nState:\", state)\n",
        "\n",
        "        for action in actions:\n",
        "            print(\n",
        "                action, \"=\",\n",
        "                round(Q[state][action], 6)\n",
        "            )\n",
        "\n",
        "    # STEP 3: POLICY IMPROVEMENT\n",
        "    old_policy = policy.copy()\n",
        "\n",
        "    for state in states:\n",
        "        best_action = max(\n",
        "            actions,\n",
        "            key=lambda action: Q[state][action]\n",
        "        )\n",
        "\n",
        "        policy[state] = best_action\n",
        "\n",
        "    print(\"\\nImproved Policy:\")\n",
        "\n",
        "    for state in states:\n",
        "        print(state, \"->\", policy[state])\n",
        "\n",
        "    # STEP 4: CHECK POLICY STABILITY\n",
        "    if policy == old_policy:\n",
        "        print(\"\\nPolicy is stable.\")\n",
        "        break\n",
        "\n",
        "    print(\"\\nPolicy changed. Repeating Policy Iteration...\")\n",
        "\n",
        "# 5. Display final optimal state values\n",
        "print(\"\\n===== FINAL OPTIMAL STATE VALUES =====\")\n",
        "\n",
        "for state in states + [goal_state]:\n",
        "    print(\n",
        "        \"V(\" + state + \") =\",\n",
        "        round(V[state], 6)\n",
        "    )\n",
        "\n",
        "# 6. Display final action-value table\n",
        "print(\"\\n===== FINAL ACTION VALUE TABLE =====\")\n",
        "\n",
        "for state in states:\n",
        "    print(\"\\nState:\", state)\n",
        "\n",
        "    for action in actions:\n",
        "        print(\n",
        "            action, \"=\",\n",
        "            round(Q[state][action], 6)\n",
        "        )\n",
        "\n",
        "# 7. Display the optimal policy\n",
        "print(\"\\n===== FINAL OPTIMAL POLICY =====\")\n",
        "\n",
        "for state in states:\n",
        "    print(state, \"->\", policy[state])\n",
        "\n",
        "# 8. Verify Bellman Optimality\n",
        "print(\"\\n===== BELLMAN OPTIMALITY VERIFICATION =====\")\n",
        "\n",
        "for state in states:\n",
        "    maximum_q = max(Q[state].values())\n",
        "\n",
        "    print(\n",
        "        \"V(\" + state + \") =\",\n",
        "        round(V[state], 6),\n",
        "        \"| max Q(\" + state + \", a) =\",\n",
        "        round(maximum_q, 6),\n",
        "        \"| Verified:\",\n",
        "        abs(V[state] - maximum_q) < 1e-6\n",
        "    )\n",
        "\n",
        "# 9. Display the optimal path\n",
        "print(\"\\n===== OPTIMAL PATH =====\")\n",
        "\n",
        "current_state = \"S0\"\n",
        "path = [current_state]\n",
        "\n",
        "while current_state != goal_state:\n",
        "    action = policy[current_state]\n",
        "\n",
        "    next_state, reward = transitions[current_state][action]\n",
        "\n",
        "    if next_state == current_state:\n",
        "        print(\"Error: Policy does not lead to the goal.\")\n",
        "        break\n",
        "\n",
        "    current_state = next_state\n",
        "    path.append(current_state)\n",
        "\n",
        "print(\" -> \".join(path))\n",
        "\n",
        "print(\"\\nPolicy Iteration completed successfully.\")"
      ],
