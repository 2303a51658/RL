        "import random\n",
        "\n",
        "# Part A - Machine Initialization\n",
        "machines = ['A', 'B', 'C']\n",
        "\n",
        "# Number of machines and plays\n",
        "M = 3\n",
        "N_play = 10\n",
        "E = 0.2\n",
        "\n",
        "# Part B - Initialize N, R and Q tables\n",
        "N = {'A': 0, 'B': 0, 'C': 0}   # Number of times each machine is selected\n",
        "R = {'A': 0, 'B': 0, 'C': 0}   # Total reward received from each machine\n",
        "Q = {'A': 0.0, 'B': 0.0, 'C': 0.0}  # Estimated Q-values\n",
        "\n",
        "total_reward = 0\n",
        "\n",
        "print(\"E-Greedy Strategy for Multi-Armed Bandit\")\n",
        "print(\"------------------------------------------\")\n",
        "\n",
        "# Part C - E-Greedy Decision\n",
        "for play in range(1, N_play + 1):\n",
        "\n",
        "    # Generate random number between 0 and 1\n",
        "    r = random.random()\n",
        "\n",
        "    if r < E:\n",
        "        # Exploration\n",
        "        selected_machine = random.choice(machines)\n",
        "        decision = \"Exploration\"\n",
        "    else:\n",
        "        # Exploitation\n",
        "        max_q = max(Q.values())\n",
        "\n",
        "        # If multiple machines have same Q-value,\n",
        "        # randomly select among them\n",
        "        best_machines = [\n",
        "            machine for machine in machines\n",
        "            if Q[machine] == max_q\n",
        "        ]\n",
        "\n",
        "        selected_machine = random.choice(best_machines)\n",
        "        decision = \"Exploitation\"\n",
        "\n",
        "    print(f\"\\nPlay {play}\")\n",
        "    print(f\"Random number: {r:.4f}\")\n",
        "    print(f\"Decision: {decision}\")\n",
        "    print(f\"Selected machine: {selected_machine}\")\n",
        "\n",
        "    # Part D - Reward Collection\n",
        "    reward = float(input(f\"Enter reward obtained from machine {selected_machine}: \"))\n",
        "\n",
        "    # Part E - Q-Value Update\n",
        "    N[selected_machine] += 1\n",
        "    R[selected_machine] += reward\n",
        "\n",
        "    # Incremental sample-average formula:\n",
        "    # Q(a) = Q(a) + [R - Q(a)] / N(a)\n",
        "\n",
        "    Q[selected_machine] = (\n",
        "        Q[selected_machine]\n",
        "        + (reward - Q[selected_machine]) / N[selected_machine]\n",
        "    )\n",
        "\n",
        "    total_reward += reward\n",
        "\n",
        "    print(f\"Updated Q-value of {selected_machine}: \"\n",
        "          f\"{Q[selected_machine]:.2f}\")\n",
        "\n",
        "# Part F - Display Results\n",
        "print(\"\\n==========================================\")\n",
        "print(\"FINAL RESULTS\")\n",
        "print(\"==========================================\")\n",
        "\n",
        "print(\"\\nMachine\\tN (Count)\\tR (Total Reward)\\tQ (Estimated Value)\")\n",
        "\n",
        "for machine in machines:\n",
        "    print(\n",
        "        f\"{machine}\\t{N[machine]}\\t\\t\"\n",
        "        f\"{R[machine]:.2f}\\t\\t{Q[machine]:.2f}\"\n",
        "    )\n",
        "\n",
        "print(\"\\nTotal Reward received after 10 plays:\", total_reward)\n",
        "\n",
        "print(\"\\nAnalysis:\")\n",
        "for machine in machines:\n",
        "    print(\n",
        "        f\"Machine {machine}: selected {N[machine]} times, \"\n",
        "        f\"total reward = {R[machine]:.2f}, \"\n",
        "        f\"estimated Q-value = {Q[machine]:.2f}\"\n",
        "    )"
      ]
    }
