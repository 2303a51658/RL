        "# Assignment 2: Bellman Expectation Equations\n",
        "# Stochastic Environment with a Deterministic Policy\n",
        "\n",
        "def main():\n",
        "    gamma = 0.9\n",
        "    theta = 0.000001\n",
        "\n",
        "    # Initialize state values\n",
        "    V_S0 = 0.0\n",
        "    V_S1 = 0.0\n",
        "    iterations = 0\n",
        "\n",
        "    # Iterative Policy Evaluation\n",
        "    while True:\n",
        "        old_S0 = V_S0\n",
        "        old_S1 = V_S1\n",
        "\n",
        "        # S0: Down\n",
        "        # Wall with probability 0.1, S1 with probability 0.9\n",
        "        new_S0 = (\n",
        "            0.1 * (-1 + gamma * 0.0)\n",
        "            + 0.9 * (-1 + gamma * old_S1)\n",
        "        )\n",
        "\n",
        "        # S1: Right\n",
        "        # Goal with probability 0.9, S0 with probability 0.1\n",
        "        new_S1 = (\n",
        "            0.9 * (100 + gamma * 0.0)\n",
        "            + 0.1 * (-1 + gamma * old_S0)\n",
        "        )\n",
        "\n",
        "        # Maximum change between successive iterations\n",
        "        delta = max(\n",
        "            abs(new_S0 - old_S0),\n",
        "            abs(new_S1 - old_S1)\n",
        "        )\n",
        "\n",
        "        V_S0 = new_S0\n",
        "        V_S1 = new_S1\n",
        "        iterations += 1\n",
        "\n",
        "        # Stop when the convergence threshold is reached\n",
        "        if delta < theta:\n",
        "            break\n",
        "\n",
        "    # Calculate action values after convergence\n",
        "\n",
        "    # Q(S0, Down): Wall (0.1), S1 (0.9)\n",
        "    Q_S0_Down = (\n",
        "        0.1 * (-1 + gamma * 0.0)\n",
        "        + 0.9 * (-1 + gamma * V_S1)\n",
        "    )\n",
        "\n",
        "    # Q(S0, Right): Wall deterministically\n",
        "    Q_S0_Right = -1 + gamma * 0.0\n",
        "\n",
        "    # Q(S1, Right): Goal (0.9), S0 (0.1)\n",
        "    Q_S1_Right = (\n",
        "        0.9 * (100 + gamma * 0.0)\n",
        "        + 0.1 * (-1 + gamma * V_S0)\n",
        "    )\n",
        "\n",
        "    # Q(S1, Up): S0 deterministically\n",
        "    Q_S1_Up = -1 + gamma * V_S0\n",
        "\n",
        "    # Display results\n",
        "    print(\"===== ITERATIVE POLICY EVALUATION =====\")\n",
        "    print(\"Convergence threshold:\", theta)\n",
        "    print(\"Number of iterations:\", iterations)\n",
        "    print(f\"V_pi(S0) = {V_S0:.6f}\")\n",
        "    print(f\"V_pi(S1) = {V_S1:.6f}\")\n",
        "    print(f\"Final delta = {delta:.10f}\")\n",
        "\n",
        "    print(\"\\n===== ACTION VALUES =====\")\n",
        "    print(f\"Q_pi(S0, Down)  = {Q_S0_Down:.6f}\")\n",
        "    print(f\"Q_pi(S0, Right) = {Q_S0_Right:.6f}\")\n",
        "    print(f\"Q_pi(S1, Right) = {Q_S1_Right:.6f}\")\n",
        "    print(f\"Q_pi(S1, Up)    = {Q_S1_Up:.6f}\")\n",
        "\n",
        "    # Verify policy consistency\n",
        "    print(\"\\n===== POLICY CONSISTENCY CHECK =====\")\n",
        "\n",
        "    check_S0 = abs(V_S0 - Q_S0_Down) < 0.000001\n",
        "    check_S1 = abs(V_S1 - Q_S1_Right) < 0.000001\n",
        "\n",
        "    print(f\"V_pi(S0) = Q_pi(S0, Down): {check_S0}\")\n",
        "    print(f\"V_pi(S1) = Q_pi(S1, Right): {check_S1}\")\n",
        "\n",
        "    if check_S0 and check_S1:\n",
        "        print(\"Policy consistency: PASSED\")\n",
        "    else:\n",
        "        print(\"Policy consistency: FAILED\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
