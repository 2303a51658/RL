        "# Bellman Expectation Equations - 2 x 2 Grid World\n",
        "# Direct algebraic solution (no iterative policy evaluation)\n",
        "\n",
        "def main():\n",
        "    gamma = 0.9\n",
        "\n",
        "    # Rewards\n",
        "    normal_reward = -1\n",
        "    wall_reward = -1\n",
        "    goal_reward = 100\n",
        "\n",
        "    # Policy probabilities\n",
        "    p_down = 0.9\n",
        "    p_right_s0 = 0.1\n",
        "    p_right_s1 = 0.9\n",
        "    p_up = 0.1\n",
        "\n",
        "    # State transitions:\n",
        "    # S0 --Down--> S1, reward -1\n",
        "    # S0 --Right--> Wall, reward -1\n",
        "    # S1 --Right--> G, reward +100\n",
        "    # S1 --Up--> S0, reward -1\n",
        "    # G is terminal, V(G) = 0\n",
        "\n",
        "    # Bellman equations:\n",
        "    # V(S0) = 0.9*(-1 + gamma*V(S1))\n",
        "    #        + 0.1*(-1 + gamma*V(Wall))\n",
        "    #\n",
        "    # V(S1) = 0.9*(100 + gamma*V(G))\n",
        "    #        + 0.1*(-1 + gamma*V(S0))\n",
        "    #\n",
        "    # Wall is treated as a non-terminal state with V(Wall) = 0,\n",
        "    # because no further wall-state transition is specified.\n",
        "    # V(G) = 0 as given in the question.\n",
        "\n",
        "    # Simplified simultaneous equations:\n",
        "    # V(S0) = -1 + 0.81*V(S1)\n",
        "    # V(S1) = 89.9 + 0.09*V(S0)\n",
        "\n",
        "    # Substitute the second equation into the first:\n",
        "    # V(S0) = -1 + 0.81*(89.9 + 0.09*V(S0))\n",
        "    #\n",
        "    # V(S0)*(1 - 0.81*0.09) = -1 + 0.81*89.9\n",
        "\n",
        "    v_s0 = (-1 + p_down * gamma * (\n",
        "        p_right_s1 * (goal_reward + gamma * 0)\n",
        "        + p_up * (normal_reward)\n",
        "    ) + p_right_s0 * gamma * 0) / (\n",
        "        1 - p_down * gamma * p_up * gamma\n",
        "    )\n",
        "\n",
        "    # Calculate V(S1) using its Bellman equation\n",
        "    v_s1 = (\n",
        "        p_right_s1 * (goal_reward + gamma * 0)\n",
        "        + p_up * (normal_reward + gamma * v_s0)\n",
        "    )\n",
        "\n",
        "    # Action values: Q(s,a) = R(s,a) + gamma*V(next_state)\n",
        "    q_s0_down = normal_reward + gamma * v_s1\n",
        "    q_s0_right = wall_reward + gamma * 0\n",
        "    q_s1_right = goal_reward + gamma * 0\n",
        "    q_s1_up = normal_reward + gamma * v_s0\n",
        "\n",
        "    # Display state values\n",
        "    print(\"===== BELLMAN EXPECTATION EQUATIONS =====\")\n",
        "    print(f\"V(S0) = {v_s0:.2f}\")\n",
        "    print(f\"V(S1) = {v_s1:.2f}\")\n",
        "\n",
        "    # Display action values\n",
        "    print(\"\\n===== ACTION VALUES =====\")\n",
        "    print(f\"Q(S0, Down)  = {q_s0_down:.2f}\")\n",
        "    print(f\"Q(S0, Right) = {q_s0_right:.2f}\")\n",
        "    print(f\"Q(S1, Right) = {q_s1_right:.2f}\")\n",
        "    print(f\"Q(S1, Up)    = {q_s1_up:.2f}\")\n",
        "\n",
        "    # Verify the Bellman expectation equations\n",
        "    check_v_s0 = p_down * q_s0_down + p_right_s0 * q_s0_right\n",
        "    check_v_s1 = p_right_s1 * q_s1_right + p_up * q_s1_up\n",
        "\n",
        "    print(\"\\n===== VERIFICATION =====\")\n",
        "    print(f\"Calculated V(S0) = {v_s0:.2f}\")\n",
        "    print(f\"Verified  V(S0) = {check_v_s0:.2f}\")\n",
        "    print(f\"Calculated V(S1) = {v_s1:.2f}\")\n",
