        "## Building a Random Agent for Reinforcement Learning Environments\n",
        "\n",
        "This section implements a simple Random Agent to interact with various Gymnasium (formerly OpenAI Gym) environments. The agent will choose actions randomly from the environment's action space and track the rewards received."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c2e01c8d",
        "outputId": "cf07621a-8f2e-4ead-b49f-a535ff3a53ba"
      },
      "source": [
        "import gymnasium as gym\n",
        "\n",
        "def random_agent(env_name, episodes=5, render_mode=None):\n",
        "    \"\"\"Runs a random agent on a specified Gymnasium environment for a given number of episodes.\"\"\"\n",
        "    print(f\"\\n----- {env_name} -----\")\n",
        "    env = gym.make(env_name, render_mode=render_mode)\n",
        "\n",
        "    rewards = []\n",
        "    episode_lengths = []\n",
        "\n",
        "    for episode in range(1, episodes + 1):\n",
        "        state, info = env.reset()\n",
        "        total_reward = 0\n",
        "        steps = 0\n",
        "\n",
        "        terminated = False\n",
        "        truncated = False\n",
        "\n",
        "        while not (terminated or truncated):\n",
        "            action = env.action_space.sample()  # Randomly select an action\n",
        "\n",
        "            next_state, reward, terminated, truncated, info = env.step(action)\n",
        "\n",
        "            total_reward += reward\n",
        "            state = next_state\n",
        "            steps += 1\n",
        "\n",
        "        rewards.append(total_reward)\n",
        "        episode_lengths.append(steps)\n",
        "\n",
        "        print(f\"Episode {episode}: Total Reward = {total_reward}, Steps = {steps}\")\n",
        "\n",
        "    if rewards:\n",
        "        average_reward = sum(rewards) / len(rewards)\n",
        "        average_steps = sum(episode_lengths) / len(episode_lengths)\n",
        "        print(f\"\\nAverage Reward = {average_reward:.2f}\")\n",
        "        print(f\"Average Steps = {average_steps:.2f}\")\n",
        "    else:\n",
        "        print(\"No episodes completed.\")\n",
        "\n",
        "    env.close()\n",
        "\n",
        "# Run the random agent on the specified environments\n",
        "random_agent(\"CartPole-v1\", episodes=5)\n",
        "random_agent(\"MountainCar-v0\", episodes=5)\n",
        "random_agent(\"FrozenLake-v1\", episodes=5, render_mode=\"ansi\") # render_mode='ansi' for text-based visualization"
